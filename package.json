{
  "name": "night-shift-report",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "description": "Print-first Windows night shift report application",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron .",
    "build": "prisma generate && electron-vite build && node scripts/stage-runtime-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:packaged": "set TEST_PACKAGED=1&& playwright test --grep \"packaged Windows\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "db:validate": "prisma validate",
    "verify": "prisma generate && pnpm lint && pnpm typecheck && pnpm test && pnpm db:validate && pnpm build && pnpm test:e2e",
    "package:portable": "pnpm build && electron-builder --win portable",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "prisma": "6.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
