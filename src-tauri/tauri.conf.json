{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Night Shift Report",
  "mainBinaryName": "Night Shift Report",
  "version": "../package.json",
  "identifier": "com.vince.nightshiftreport",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Night Shift Report",
        "width": 1500,
        "height": 960,
        "minWidth": 1180,
        "minHeight": 760,
        "visible": false,
        "decorations": false,
        "dragDropEnabled": false,
        "transparent": true,
        "theme": "Light",
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
